# ==============================================================================
# TỐI THIỂU HÓA CẤU HÌNH & ENVIRONMENT VARIABLES
# Quy tắc bắt buộc:
# 1. Login Google qua Supabase (@supabase/supabase-js)
# 2. JWT token expired sau 1h (3600s)
# 3. Có đọc/lưu data trực tiếp thì có thêm DATABASE_URL
# 4. Có AI function thì có thêm OPENAI_API_KEY và GEMINI_API_KEY
# 5. NGOÀI RA CẦN THÊM CẤU HÌNH GÌ KHÁC BẮT BUỘC PHẢI HỎI Ý KIẾN NGƯỜI DÙNG!
# ==============================================================================

# --- 1. Supabase Auth & Client (Google Login) ---
# Dành cho ứng dụng Vite (Mặc định trong dự án)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Dành cho ứng dụng Next.js App Router
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- 2. Database URL (Chỉ thêm khi ứng dụng có đọc/lưu data trực tiếp ở Server/API/Backend) ---
# DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- 3. AI Functions (Chỉ thêm khi ứng dụng có tính năng AI) ---
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
